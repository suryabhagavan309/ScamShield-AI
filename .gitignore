# ==============================================================================
# ScamShield AI - Git Ignore Configuration
# Comprehensive ignore rules for Python, FastAPI, React, Vite, Node.js, and Windows
# ==============================================================================

# --- Python Virtual Environments & Packages ---
.venv/
*/.venv/
venv/
*/venv/
env/
*/env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Python Bytecode & Runtime Caches ---
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# --- Testing & Coverage Artifacts ---
.pytest_cache/
*/.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.tox/
.nox/

# --- Node.js & Frontend Build Outputs ---
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Vite / Frontend build artifacts
frontend/dist/
dist/
dist-ssr/
*.local

# --- Environment Configurations & Secrets ---
# Disallow actual environment files with real secrets
.env
.env.*
!.env.example
!*/.env.example
*.env
!*.env.example

# Secret keys, credentials & certs
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
credentials.json
*secret*
!*secret*.py
!*secret*.test.*
!*secret*.ts
!*secret*.tsx

# --- Operating System & Windows Artifacts ---
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk
.DS_Store
.AppleDouble
.LSOverride

# --- Editor & IDE Directories ---
.vscode/*
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
*.tmp

# --- Local Databases & Volatile Logs ---
*.db
*.sqlite
*.sqlite3
*.log
logs/
*/logs/
