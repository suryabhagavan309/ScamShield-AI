# ==============================================================================
# ScamShield AI - Backend Environment Configuration Template
# ==============================================================================

HOST=0.0.0.0
PORT=8000
DEBUG=true
ENVIRONMENT=prototype

# ------------------------------------------------------------------------------
# Assessment Provider Selection
# ------------------------------------------------------------------------------
# Mode options:
#   - "mock_synthetic" (Default): Runs local rule-based synthetic heuristics.
#                                 Zero external cloud calls or AWS keys needed.
#   - "aws_bedrock":              Invokes AWS Bedrock foundation models via boto3.
ASSESSMENT_PROVIDER_MODE=mock_synthetic

# ------------------------------------------------------------------------------
# AWS Bedrock Foundation Model Configuration (Used when mode=aws_bedrock)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1

# Recommended model ID options on AWS Bedrock:
#   - Claude 3 Haiku (Cost-efficient, fast): anthropic.claude-3-haiku-20240307-v1:0
#   - Claude 3.5 Sonnet (High intelligence): anthropic.claude-3-5-sonnet-20240620-v1:0
#   - Amazon Titan Text Express: amazon.titan-text-express-v1
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Safe Fallback: If credentials expire or AWS fails, seamlessly fall back to mock heuristics
AWS_BEDROCK_FALLBACK_TO_MOCK=true
AWS_BEDROCK_TEMPERATURE=0.0
AWS_BEDROCK_MAX_TOKENS=1024

# AWS Authentication (Optional if using IAM EC2/ECS/EKS Instance Profiles or AWS SSO):
# Leave commented out if relying on ~/.aws/credentials or IAM instance profiles.
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS_SESSION_TOKEN=optional_session_token_here

# ------------------------------------------------------------------------------
# Safety & Privacy Guardrails (Strictly Preserved)
# ------------------------------------------------------------------------------
# Storage of sensitive PII (passwords, bank accounts, SSNs) is strictly prohibited.
STORE_SENSITIVE_PII=false

# Trusted contact alerts are simulated; no real SMS/email transmission in prototype.
MOCK_ALERT_DISPATCH=true

# Automated bank transfers or payment blocking are strictly disabled by design.
ALLOW_AUTOMATED_FINANCIAL_ACTIONS=false
