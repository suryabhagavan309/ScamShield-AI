# ==============================================================================
# ScamShield AI - Root Environment Reference Template
# ==============================================================================
# ScamShield AI is preconfigured to run completely offline by default using local
# synthetic heuristics with zero cloud setup or AWS credentials required.
#
# If you wish to enable live AWS Bedrock foundation model assessments, copy this
# file to backend/.env and configure your AWS settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Configuration (backend/.env)
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=prototype

# Provider Mode:
#   - "mock_synthetic" (Default): Offline local rule-based heuristics engine.
#   - "aws_bedrock":              AWS Bedrock foundation models (Anthropic Claude 3 Haiku).
ASSESSMENT_PROVIDER_MODE=mock_synthetic

# AWS Bedrock Settings (active when ASSESSMENT_PROVIDER_MODE=aws_bedrock)
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
AWS_BEDROCK_FALLBACK_TO_MOCK=true
AWS_BEDROCK_TEMPERATURE=0.0
AWS_BEDROCK_MAX_TOKENS=1024

# AWS Authentication (Optional if using AWS SSO, AWS CLI, or IAM Roles)
# AWS_ACCESS_KEY_ID=your_access_key_placeholder
# AWS_SECRET_ACCESS_KEY=your_secret_key_placeholder
# AWS_SESSION_TOKEN=optional_session_token_placeholder

# ------------------------------------------------------------------------------
# Frontend Service Configuration (frontend/.env)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_MODE=prototype
VITE_ASSESSMENT_ENGINE=mock_synthetic

# ------------------------------------------------------------------------------
# Security & Privacy Directives (Hardcoded & Preserved)
# ------------------------------------------------------------------------------
# STORE_SENSITIVE_PII=false
# ALLOW_AUTOMATED_FINANCIAL_ACTIONS=false
